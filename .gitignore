*.log

# Trained model artifacts (regenerated by train_rl.py)
*.zip

# TensorBoard logs
tb_logs/

# Saved battle replays (generated by play.py)
replays/

# Backups / scratch
backup_old/

# Claude Code local settings (personal, machine-specific)
.claude/settings.local.json

# Showdown ladder credentials (never commit)
.env
