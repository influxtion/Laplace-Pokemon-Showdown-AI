# Python
.venv/
__pycache__/
*.pyc

# Local Pokemon Showdown server (cloned separately, not our code)
server/

# Foul Play benchmark opponent (cloned separately, not our code)
foul-play/

# Value-net training data (regenerated by gen_value_data.py)
data_value*/

